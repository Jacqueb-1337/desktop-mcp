{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop MCP",
  "version": "0.3.1",
  "identifier": "com.jacqueb.desktopmcp",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "tray",
        "title": "Desktop MCP",
        "width": 386,
        "height": 704,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"]
  }
}
